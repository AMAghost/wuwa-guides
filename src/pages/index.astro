---
import { getCollection } from 'astro:content';

const guides = await getCollection('guides');
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>WuWa Guides | Гайды Wuthering Waves</title>
    <!-- Скрипт авторизации Netlify Identity -->
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <style>
      :root {
        --bg-color: #0f172a;
        --card-bg: #1e293b;
        --accent: #38bdf8;
        --text: #f8fafc;
        --text-muted: #94a3b8;
      }
      body {
        background-color: var(--bg-color);
        color: var(--text);
        font-family: system-ui, -apple-system, sans-serif;
        margin: 0;
        padding: 0;
      }
      header {
        background: #020617;
        padding: 1.5rem 2rem;
        border-bottom: 1px solid #334155;
      }
      header h1 {
        margin: 0;
        font-size: 1.5rem;
        color: var(--accent);
      }
      main {
        max-width: 1000px;
        margin: 2rem auto;
        padding: 0 1rem;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
        margin-top: 1.5rem;
      }
      .card {
        background: var(--card-bg);
        border: 1px solid #334155;
        border-radius: 12px;
        padding: 1.5rem;
        text-decoration: none;
        color: inherit;
        transition: transform 0.2s, border-color 0.2s;
      }
      .card:hover {
        transform: translateY(-4px);
        border-color: var(--accent);
      }
      .tag {
        display: inline-block;
        background: #020617;
        color: var(--accent);
        padding: 0.2rem 0.6rem;
        border-radius: 4px;
        font-size: 0.8rem;
        font-weight: bold;
        margin-right: 0.5rem;
      }
      .role {
        color: var(--text-muted);
        font-size: 0.9rem;
      }
    </style>
  </head>
  <body>
    <header>
      <h1>Wuthering Waves Guides</h1>
    </header>
    <main>
      <h2>Персонажи и билды</h2>
      <div class="grid">
        {guides.map((guide) => (
          <a href={`/guides/${guide.id}`} class="card">
            <div>
              <span class="tag">{guide.data.element}</span>
              <span class="role">{guide.data.role}</span>
            </div>
            <h3 style="margin: 0.8rem 0 0.4rem 0;">{guide.data.title}</h3>
            <p style="color: #94a3b8; font-size: 0.9rem; margin: 0;">
              {guide.data.description}
            </p>
          </a>
        ))}
      </div>
    </main>
  </body>
</html>