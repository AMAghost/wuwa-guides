---
import { getCollection } from 'astro:content';

// 1. Загружаем все коллекции
const guides = await getCollection('guides');
const characters = await getCollection('characters');
const weapons = await getCollection('weapons');
const echoSets = await getCollection('echoSets');

// Создаем удобные словари (Map) для быстрого поиска иконок и названий по ID
const charMap = new Map(characters.map((c) => [c.data.id, c.data]));
const weaponMap = new Map(weapons.map((w) => [w.data.id, w.data]));
const echoMap = new Map(echoSets.map((e) => [e.data.id, e.data]));
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WuWa Guides | Гайды Wuthering Waves</title>
    
    <!-- Подключаем скрипт авторизации Netlify Identity локально -->
    <script>
      // @ts-ignore
      import netlifyIdentity from 'netlify-identity-widget';
      (window as any).netlifyIdentity = netlifyIdentity;
      netlifyIdentity.init();
    </script>
    
    <style>
      :root {
        --bg-main: #0b0f17;
        --card-bg: #161e2e;
        --card-border: #2a364f;
        --accent: #38bdf8;
        --accent-glow: rgba(56, 189, 248, 0.25);
        --text: #f8fafc;
        --text-sub: #94a3b8;
      }
      * {
        box-sizing: border-box;
      }
      body {
        background-color: var(--bg-main);
        color: var(--text);
        font-family: system-ui, -apple-system, sans-serif;
        margin: 0;
        padding: 0;
      }
      header {
        background: #060911;
        padding: 1.5rem 2rem;
        border-bottom: 1px solid var(--card-border);
      }
      header h1 {
        margin: 0;
        font-size: 1.6rem;
        color: var(--accent);
        letter-spacing: 0.5px;
      }
      main {
        max-width: 1200px;
        margin: 2rem auto;
        padding: 0 1rem;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 1.5rem;
        margin-top: 1.5rem;
      }
      .card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 16px;
        padding: 1.25rem;
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
      }
      .card:hover {
        transform: translateY(-4px);
        border-color: var(--accent);
        box-shadow: 0 8px 24px var(--accent-glow);
      }
      .card-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
      }
      .char-avatar {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid var(--accent);
      }
      .meta-tags {
        display: flex;
        gap: 0.4rem;
        margin-bottom: 0.4rem;
      }
      .tag {
        background: #090d16;
        color: var(--accent);
        padding: 0.2rem 0.5rem;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
      }
      .team-preview {
        margin-top: 1rem;
        padding-top: 0.8rem;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
      }
      .team-preview span {
        display: block;
        font-size: 0.8rem;
        color: var(--text-sub);
        margin-bottom: 0.5rem;
      }
      .team-icons {
        display: flex;
        gap: 0.5rem;
      }
      .team-icons img {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 1px solid var(--card-border);
        object-fit: cover;
      }
    </style>
  </head>
  <body>
    <header>
      <h1>Wuthering Waves Guides</h1>
    </header>
    <main>
      <h2>Гайды и Билды Персонажей</h2>
      <div class="grid">
        {guides.map((guide) => {
          // Находим информацию о персонаже в базе
          const charData = charMap.get(guide.data.characterId);
          // Берем главную пачку для превью
          const mainTeam = guide.data.teams?.[0];

          return (
            <a href={`/guides/${guide.id}`} class="card">
              <div>
                <div class="card-header">
                  {charData?.avatar && (
                    <img src={charData.avatar} alt={charData.name} class="char-avatar" />
                  )}
                  <div>
                    <div class="meta-tags">
                      <span class="tag">{guide.data.element}</span>
                      <span class="tag">{guide.data.rarity}★</span>
                    </div>
                    <h3 style="margin: 0; font-size: 1.2rem;">{guide.data.title}</h3>
                    <small style="color: var(--text-sub);">{guide.data.role}</small>
                  </div>
                </div>

                <p style="color: var(--text-sub); font-size: 0.9rem; line-height: 1.4; margin: 0 0 1rem 0;">
                  {guide.data.description}
                </p>
              </div>

              <!-- Превью топовой пачки (3 иконки) -->
              {mainTeam && (
                <div class="team-preview">
                  <span>Рекомендуемый состав ({mainTeam.name}):</span>
                  <div class="team-icons">
                    {mainTeam.memberIds.map((memberId) => {
                      const member = charMap.get(memberId);
                      return member?.avatar ? (
                        <img src={member.avatar} alt={member.name} title={member.name} />
                      ) : null;
                    })}
                  </div>
                </div>
              )}
            </a>
          );
        })}
      </div>
    </main>
  </body>
</html>