---
import { getCollection } from 'astro:content';

// Функция обязательна для динамических страниц в статическом режиме (SSG)
export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { id: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { data } = guide;
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <title>{data.title} — Гайд Wuthering Waves</title>
    <style>
      body { background: #0b0f17; color: #f8fafc; font-family: sans-serif; padding: 2rem; max-width: 800px; margin: 0 auto; }
      a { color: #38bdf8; text-decoration: none; }
    </style>
  </head>
  <body>
    <a href="/">← На главную</a>
    <h1>{data.title}</h1>
    <p><strong>Элемент:</strong> {data.element} | <strong>Роль:</strong> {data.role}</p>
    <p>{data.description}</p>
  </body>
</html>