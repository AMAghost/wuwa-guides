---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { id: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const data = guide.data as any;

// Загружаем справочники для подтягивания иконок и названий
const characters = await getCollection('characters' as any);
const weapons = await getCollection('weapons' as any);
const echoSets = await getCollection('echoSets' as any);

const charMap = new Map(characters.map((c: any) => [c.data?.id || c.id, c.data]));
const weaponMap = new Map(weapons.map((w: any) => [w.data?.id || w.id, w.data]));
const echoMap = new Map(echoSets.map((e: any) => [e.data?.id || e.id, e.data]));

const charData = charMap.get(data.characterId) || {};
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <title>{data.title} — Гайд Wuthering Waves</title>
    <style>
      :root {
        --bg-main: #07090e;
        --card-bg: rgba(18, 24, 38, 0.7);
        --card-border: rgba(56, 189, 248, 0.2);
        --accent: #38bdf8;
        --accent-glow: rgba(56, 189, 248, 0.15);
        --text: #f8fafc;
        --text-sub: #94a3b8;
      }
      body {
        background-color: var(--bg-main);
        color: var(--text);
        font-family: system-ui, -apple-system, sans-serif;
        margin: 0;
        padding: 0;
        background-image: radial-gradient(circle at 50% 0%, #111e38 0%, transparent 50%);
        background-attachment: fixed;
      }
      .container {
        max-width: 1000px;
        margin: 2.5rem auto;
        padding: 0 1.5rem;
      }
      .back-link {
        color: var(--text-sub);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 2rem;
        font-size: 0.9rem;
        transition: color 0.2s;
      }
      .back-link:hover { color: var(--accent); }

      /* --- PREMIER HERO CARD DESIGN --- */
      .hero-card {
        position: relative;
        background: var(--card-bg);
        backdrop-filter: blur(12px);
        border: 1px solid var(--card-border);
        border-radius: 24px;
        padding: 2.5rem;
        display: flex;
        align-items: center;
        gap: 3rem;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5), 0 0 30px var(--accent-glow);
        overflow: hidden;
        margin-bottom: 2rem;
      }
      /* Декоративная подсветка сзади */
      .hero-card::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -20%;
        width: 300px;
        height: 300px;
        background: var(--accent);
        opacity: 0.08;
        filter: blur(80px);
        border-radius: 50%;
        pointer-events: none;
      }
      .hero-art-wrapper {
        position: relative;
        flex-shrink: 0;
      }
      .hero-art {
        width: 180px;
        height: 220px;
        object-fit: cover;
        border-radius: 16px;
        border: 2px solid rgba(56, 189, 248, 0.4);
        box-shadow: 0 10px 25px rgba(0,0,0,0.6);
        background: #0b0f17;
      }
      .hero-info {
        flex-grow: 1;
        z-index: 1;
      }
      .badges-row {
        display: flex;
        gap: 0.6rem;
        margin-bottom: 1rem;
      }
      .badge {
        background: rgba(56, 189, 248, 0.1);
        border: 1px solid rgba(56, 189, 248, 0.3);
        color: var(--accent);
        padding: 0.3rem 0.8rem;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        text-transform: uppercase;
      }
      .hero-title {
        margin: 0 0 0.5rem 0;
        font-size: 2.8rem;
        font-weight: 800;
        letter-spacing: -0.5px;
        background: linear-gradient(135deg, #fff 30%, #94a3b8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      .hero-role {
        font-size: 1.1rem;
        color: var(--text-sub);
        margin: 0 0 1rem 0;
      }
      .hero-role strong {
        color: var(--text);
      }
      .hero-desc {
        color: var(--text-sub);
        font-size: 0.95rem;
        line-height: 1.6;
        margin: 0;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        padding-top: 1rem;
      }

      @media (max-width: 768px) {
        .hero-card { flex-direction: column; text-align: center; gap: 1.5rem; padding: 1.5rem; }
        .badges-row { justify-content: center; }
        .hero-title { font-size: 2.2rem; }
      }

      .grid-stats-section {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
      }
      .content-box {
        background: var(--card-bg);
        backdrop-filter: blur(12px);
        border: 1px solid var(--card-border);
        border-radius: 20px;
        padding: 1.8rem;
        box-shadow: 0 8px 30px rgba(0,0,0,0.4);
      }
      .content-box h2 {
        margin: 0 0 1.2rem 0;
        font-size: 1.25rem;
        color: var(--accent);
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      /* Статы */
      .stats-grid {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
      }
      .stat-item {
        display: flex;
        justify-content: space-between;
        background: rgba(11, 15, 23, 0.6);
        padding: 0.8rem 1.2rem;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.04);
      }
      .stat-name { color: var(--text-sub); }
      .stat-value { font-weight: 700; color: var(--text); }

      /* Приоритеты статов */
      .priority-list {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
      }
      .priority-row {
        display: flex;
        align-items: center;
        gap: 1rem;
        background: rgba(11, 15, 23, 0.6);
        padding: 0.8rem 1.2rem;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.04);
      }
      .priority-rank {
        background: rgba(56, 189, 248, 0.15);
        color: var(--accent);
        padding: 0.2rem 0.6rem;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 800;
      }
      .priority-text { font-weight: 600; }

      /* Приоритет скиллов в ряд */
      .skills-priority-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
      }
      .skill-priority-card {
        background: rgba(11, 15, 23, 0.6);
        border: 1px solid rgba(56, 189, 248, 0.2);
        border-radius: 12px;
        padding: 1.2rem;
        text-align: center;
        position: relative;
        overflow: hidden;
      }
      .skill-badge-num {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--accent);
        margin-bottom: 0.4rem;
        font-weight: 700;
      }
      .skill-name {
        font-size: 1.05rem;
        font-weight: bold;
      }

      @media (max-width: 768px) {
        .grid-stats-section { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <a href="/" class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Назад к списку гайдов
      </a>

      <!-- ПРЕМИАЛЬНАЯ HERO-КАРТОЧКА -->
      <div class="hero-card">
        <div class="hero-art-wrapper">
          {data.fullArt ? (
            <img src={data.fullArt} alt={data.title} class="hero-art" />
          ) : (
            <div class="hero-art" style="display: flex; align-items: center; justify-content: center; color: var(--text-sub);">Нет арта</div>
          )}
        </div>
        <div class="hero-info">
          <div class="badges-row">
            {data.element && <span class="badge">⚡ {data.element}</span>}
            {data.rarity && <span class="badge">⭐ {data.rarity} Star</span>}
            {data.weaponType && <span class="badge">⚔️ {data.weaponType}</span>}
          </div>
          <h1 class="hero-title">{data.title}</h1>
          <p class="hero-role">Роль в отряде: <strong>{data.role || 'Не указана'}</strong></p>
          {data.description && <p class="hero-desc">{data.description}</p>}
        </div>
      </div>

      <!-- БЛОК СТАТОВ И ПРИОРИТЕТОВ -->
      <div class="grid-stats-section">
        
        <!-- Базовые статы персонажа -->
        {data.baseStats && (
          <div class="content-box">
            <h2>📈 Базовые статы</h2>
            <div class="stats-grid">
              <div class="stat-item">
                <span class="stat-name">HP (Здоровье)</span>
                <span class="stat-value">{data.baseStats.hp}</span>
              </div>
              <div class="stat-item">
                <span class="stat-name">ATK (Атака)</span>
                <span class="stat-value">{data.baseStats.atk}</span>
              </div>
              <div class="stat-item">
                <span class="stat-name">DEF (Защита)</span>
                <span class="stat-value">{data.baseStats.def}</span>
              </div>
            </div>
          </div>
        )}

        <!-- Приоритет статов (Артефакты / Эхо) -->
        {data.statPriorities && data.statPriorities.length > 0 && (
          <div class="content-box">
            <h2>🎯 Приоритет статов (Эхо)</h2>
            <div class="priority-list">
              {data.statPriorities.map((stat: string, index: number) => (
                <div class="priority-row">
                  <span class="priority-rank">#{index + 1}</span>
                  <span class="priority-text">{stat}</span>
                </div>
              ))}
            </div>
          </div>
        )}

      </div>

      <!-- Приоритет прокачки скиллов (Ступенчатый) -->
      {data.skillPriority && data.skillPriority.length > 0 && (
        <div class="content-box" style="margin-top: 1.5rem;">
          <h2>⚔️ Приоритет прокачки способностей</h2>
          <div class="skills-priority-container">
            {data.skillPriority.map((skill: string, index: number) => (
              <div class="skill-priority-card">
                <div class="skill-badge-num">Приоритет {index + 1}</div>
                <div class="skill-name">{skill}</div>
              </div>
            ))}
          </div>
        </div>
      )}

    </div>
  </body>
</html>